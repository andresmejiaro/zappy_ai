+		error(str("Replay file not found: ", path))
+		return false
+
+	while not file.eof_reached():
+		var raw = file.get_line()
+		if raw == "":
+			continue
+
+		var parsed = JSON.parse_string(raw)
+		if typeof(parsed) != TYPE_DICTIONARY:
+			continue
